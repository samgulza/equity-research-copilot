{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalystEvent",
  "type": "object",
  "required": [
    "ticker",
    "event_type",
    "claim",
    "affected_driver",
    "direction",
    "horizon",
    "materiality_score",
    "novelty_score",
    "priced_in_risk"
  ],
  "properties": {
    "ticker": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "earnings",
        "guidance",
        "analyst_revision",
        "product",
        "ai_infrastructure",
        "policy_geopolitics",
        "legal_regulatory",
        "filing",
        "supply_chain",
        "mna",
        "management",
        "capital_allocation",
        "macro",
        "general_news",
        "other"
      ]
    },
    "event_subtype": {
      "type": "string",
      "enum": [
        "beat_miss",
        "margin_expansion",
        "margin_compression",
        "segment_growth",
        "one_off_gain_loss",
        "raise",
        "cut",
        "withdraw",
        "reaffirm",
        "order_contract",
        "backlog",
        "shipment",
        "capacity_expansion",
        "inventory_correction",
        "buyback",
        "dividend",
        "dilution",
        "debt_refinancing",
        "capex",
        "approval",
        "investigation",
        "litigation",
        "fine_penalty",
        "export_control",
        "antitrust",
        "mna",
        "spin_off",
        "restructuring",
        "management_change",
        "analyst_upgrade",
        "analyst_downgrade",
        "target_raise",
        "consensus_revision",
        "unknown"
      ]
    },
    "claim": {
      "type": "string"
    },
    "affected_driver": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "mixed",
        "neutral"
      ]
    },
    "horizon": {
      "type": "string",
      "enum": [
        "1d",
        "5d",
        "20d",
        "60d",
        "1y",
        "5d-20d",
        "unknown"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quote"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "char_start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "char_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source_tier": {
            "type": "string",
            "enum": [
              "tier1",
              "tier2",
              "tier3",
              "tier4",
              "unknown"
            ]
          }
        }
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "materiality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "novelty_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "market_reaction_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "priced_in_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "published_at": {
      "type": "string"
    }
  }
}
